{
  "name": "fthisup",
  "version": "0.2.0",
  "description": "Your code works? Prove it. An AI-assisted tool that attempts to break web apps, APIs, CLIs and libraries with real execution, then reports only what really failed.",
  "keywords": [
    "testing",
    "qa",
    "fuzzing",
    "chaos-testing",
    "playwright",
    "api-testing",
    "cli-testing",
    "e2e",
    "ai",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "monorepo"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "fthisup": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs && node scripts/sync-skill.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/integration",
    "prepublishOnly": "npm test",
    "prepare": "npm run build",
    "lint": "eslint src tests/unit tests/integration tests/helpers.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.49.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph1-H/FThisUp.git"
  },
  "bugs": {
    "url": "https://github.com/Joseph1-H/FThisUp/issues"
  },
  "homepage": "https://github.com/Joseph1-H/FThisUp#readme"
}
